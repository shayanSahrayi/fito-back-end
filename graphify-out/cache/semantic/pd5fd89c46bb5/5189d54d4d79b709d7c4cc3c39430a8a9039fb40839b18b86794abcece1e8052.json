{"nodes": [{"id": "docs_product_fito_workflow_brief_workflow_brief", "label": "Fito Workflow Brief", "file_type": "paper", "source_file": "docs/product/Fito-workflow-brief.pdf", "source_location": "p.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_product_fito_workflow_brief_coach_provisioned_account", "label": "Coach-Provisioned Athlete Account", "file_type": "rationale", "source_file": "docs/product/Fito-workflow-brief.pdf", "source_location": "p.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The workflow brief, and the design review's confirmed athlete-registration note, say the coach enters phone, name, and national ID. If the person is not in the system, the account is created immediately and an SMS is sent: username is the phone and the initial password is the national ID, changeable after login. The national ID remains the identity. If the account already exists, the person is only linked and the password is not touched. Plan capacity is checked at this step. This conflicts with UC-03, which says the invitation itself creates neither the account nor the capacity use."}], "edges": [{"source": "docs_product_fito_workflow_brief_workflow_brief", "target": "docs_product_fito_design_review_fito", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/product/Fito-workflow-brief.pdf", "source_location": "p.1", "weight": 1.0}, {"source": "docs_product_fito_workflow_brief_coach_provisioned_account", "target": "docs_product_fito_design_review_athlete_invitation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/product/Fito-workflow-brief.pdf", "source_location": "p.1", "weight": 1.0}, {"source": "docs_product_fito_workflow_brief_coach_provisioned_account", "target": "docs_product_fito_design_review_national_code", "relation": "references", "confidence": "EXTRACTED", "confidence